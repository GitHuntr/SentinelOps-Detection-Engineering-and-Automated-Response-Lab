# SentinelOps Lab Environment Configuration Template
# Copy this file to .env and customize secrets before running services.
# NEVER commit the actual .env file with secrets into version control.

# ==========================================
# Host & Network Settings
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
SOC_SERVER_HOST=192.168.56.10
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ==========================================
# Security & JWT Authentication
# ==========================================
# Generate secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_a_random_32_character_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pre-shared Webhook Secret for Wazuh Alert Tailer / Forwarder
SENTINELOPS_WEBHOOK_KEY=change_me_to_a_secure_preshared_webhook_token

# ==========================================
# Database Configuration (PostgreSQL 16)
# ==========================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentinelops_db
POSTGRES_USER=sentinelops_app
POSTGRES_PASSWORD=change_me_sentinelops_db_password

# Full SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://sentinelops_app:change_me_sentinelops_db_password@127.0.0.1:5432/sentinelops_db

# ==========================================
# Wazuh SIEM Integration
# ==========================================
WAZUH_API_HOST=https://127.0.0.1
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change_me_wazuh_api_password
WAZUH_API_VERIFY_SSL=false
WAZUH_ALERTS_LOG_PATH=/var/ossec/logs/alerts/alerts.json

# ==========================================
# Threat Intelligence Connectors (Optional)
# ==========================================
# Leave blank to use pre-seeded local offline mock fixtures
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ==========================================
# Emergency & SOAR Governance
# ==========================================
EMERGENCY_KILL_SWITCH_ENABLED=true
HITL_APPROVAL_TIMEOUT_MINUTES=15

